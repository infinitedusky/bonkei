{
  "name": "bonkei",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./internal": "./dist/internal.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "build": "tsdown && node scripts/finish-build.mjs",
    "dev": "tsdown --watch --no-clean --on-success \"node scripts/finish-build.mjs\"",
    "size": "size-limit",
    "test:dist": "node --test scripts/dist.test.mjs",
    "check": "publint --strict && attw --pack . --profile esm-only && node --test scripts/dist.test.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "elkjs": "^0.9.3",
    "js-yaml": "^4.3.2",
    "libavoid-js": "0.5.0-beta.6"
  },
  "peerDependencies": {
    "react": ">=19 <19.4",
    "react-dom": ">=19 <19.4",
    "three": ">=0.170"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.170.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.3.0",
    "three": "^0.170.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.7.2"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
