{
  "name": "bonkei-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r typecheck && pnpm --filter \"./apps/*\" build && node scripts/assemble-pages.mjs && node scripts/check-pages.mjs",
    "preview": "pnpm --filter @bonkei/site exec vite preview --outDir ../../dist",
    "storybook": "pnpm --filter @bonkei/playground storybook",
    "capture": "pnpm --filter @bonkei/site capture",
    "test": "pnpm -r test"
  }
}
